# CRM 系统本地开发环境配置示例
# 复制此文件为 application-local.yml 并根据实际情况修改配置

# 服务器配置
server:
  port: 8080

# Spring 配置
spring:
  # 数据源配置
  datasource:
    url: jdbc:mysql://localhost:3306/crm?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=Asia/Shanghai
    username: root
    password: your_password_here
    druid:
      # Druid 监控页面配置
      stat-view-servlet:
        enabled: true
        login-username: admin
        login-password: admin123

  # Redis 配置
  redis:
    host: localhost
    port: 6379
    password: your_redis_password_here
    database: 0

# JWT 配置
jwt:
  # JWT 密钥（请修改为自己的密钥）
  secret: your-secret-key-change-this-in-production-environment
  # Token 有效期（单位：秒，7 天）
  expiration: 604800

# 日志配置
logging:
  level:
    root: INFO
    com.crm: DEBUG
    com.crm.system.mapper: DEBUG
    com.crm.business.mapper: DEBUG
  file:
    name: logs/crm-system-local.log

# Knife4j 配置
knife4j:
  enable: true
  production: false

# 业务配置
crm:
  # 文件上传路径（请根据实际情况修改）
  upload-path: /Users/your_username/data/crm/upload
  # 文件访问路径
  file-access-url: http://localhost:8080/files

# 开发环境特殊配置
# 1. 数据库连接信息需要根据本地 MySQL 实际配置修改
# 2. Redis 连接信息需要根据本地 Redis 实际配置修改
# 3. JWT 密钥建议使用随机生成的强密钥
# 4. 文件上传路径需要确保目录存在且有写入权限
# 5. 日志文件路径需要确保目录存在且有写入权限

# 使用方式：
# 1. 复制此文件为 application-local.yml
# 2. 修改上述配置项为实际值
# 3. 启动应用时会自动加载 application-local.yml 配置
# 4. application-local.yml 已在 .gitignore 中，不会被提交到 Git 仓库
