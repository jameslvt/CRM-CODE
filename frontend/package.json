{
  "name": "crm-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "企业级 CRM 系统 - 前端",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
